# WTF Helpdesk Production Environment Variables
# Copy this file to .env.prod and update the values

# Database password (change this!)
DB_PASSWORD=your_secure_database_password_here

# Admin password for Frappe/Helpdesk (change this!)
ADMIN_PASSWORD=your_secure_admin_password_here

# Site name (your domain)
SITE_NAME=support.wtfgyms.com

# Email for Let's Encrypt SSL certificate notifications
LETSENCRYPT_EMAIL=admin@wtfgyms.com
